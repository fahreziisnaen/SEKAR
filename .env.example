# Konfigurasi Docker Compose. Salin menjadi `.env` (satu folder dengan docker-compose.yml),
# lalu isi semua nilai yang kosong. Buat nilai acak dengan:  openssl rand -hex 32
# (gunakan hex agar aman dipakai di dalam URL koneksi database)

# Port host untuk aplikasi → http://<IP-server>:8030
# Port host yang sudah terpakai di server deploy (jangan dipakai): 80, 443, 8021, 9001.
APP_PORT=8030

DB_PASSWORD=
DB_ROOT_PASSWORD=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Kunci enkripsi rahasia MFA (Google Authenticator) di database: 64 karakter hex (openssl rand -hex 32).
# JANGAN diganti setelah ada pengguna yang memakai MFA — semua MFA harus dipasang ulang.
MFA_ENCRYPTION_KEY=

# true  = WAJIB bila diakses lewat HTTPS (mis. di belakang Caddy/nginx).
# false = hanya untuk uji coba lewat http://IP:port di jaringan lokal.
COOKIE_SECURE=true
# Isi 1 bila di belakang reverse proxy agar rate limit membaca IP asli pengguna.
TRUST_PROXY=false

MAX_UPLOAD_MB=10
APP_TIMEZONE=Asia/Jakarta

# Bootstrap instalasi baru — hanya dipakai bila data belum ada (tidak membuat data contoh).
SEED_ORG_NAME=
SEED_ADMIN_NAME=
# Username login admin pertama: huruf kecil/angka/titik/garis bawah/tanda hubung, 3–32 karakter.
SEED_ADMIN_USERNAME=
# Minimal 8 karakter. Segera ganti lewat Pengaturan › Akun Saya setelah masuk pertama kali.
SEED_ADMIN_PASSWORD=

# Hanya untuk docker-compose.dev.yml (pengembangan lokal).
DB_PORT=3306

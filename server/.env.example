# ── Server ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Koneksi MySQL. Jika memakai `npm run db:up`, samakan password dengan DB_PASSWORD di .env root.
DATABASE_URL="mysql://sekar:ganti-password-db@127.0.0.1:3306/sekar"
# Database terpisah untuk `npm test` — ISINYA DIHAPUS setiap kali test jalan. Nama wajib mengandung "test".
TEST_DATABASE_URL="mysql://sekar:ganti-password-db@127.0.0.1:3306/sekar_test"

# Rahasia JWT: string acak minimal 32 karakter, BERBEDA satu sama lain.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Kunci enkripsi rahasia MFA (Google Authenticator) di database: 64 karakter hex.
# Buat dengan: openssl rand -hex 32. JANGAN diganti setelah ada pengguna yang memakai MFA.
MFA_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
# Masa berlaku sesi bila "Ingat saya" dicentang.
REFRESH_TOKEN_TTL_DAYS=14

# Cookie `secure`: WAJIB true bila aplikasi diakses lewat HTTPS. Untuk pengembangan lokal via http set false.
COOKIE_SECURE=false
# Isi jumlah hop (mis. 1) bila server berada di belakang reverse proxy.
TRUST_PROXY=false

# Folder penyimpanan unggahan (relatif terhadap folder server/) dan batas ukurannya.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Zona waktu acuan "hari ini" untuk tenggat & notifikasi (nama IANA).
APP_TIMEZONE=Asia/Jakarta

# ── Bootstrap (npm run db:seed) — hanya dipakai bila datanya belum ada ─────
SEED_ORG_NAME=
SEED_ADMIN_NAME=
# Username login admin pertama: huruf kecil/angka/titik/garis bawah/tanda hubung, 3–32 karakter.
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
